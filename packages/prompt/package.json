{
  "name": "@secrez/prompt",
  "version": "1.0.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "all-tests": "find test/** -name '*.test.js' | xargs ./node_modules/.bin/mocha -R spec",
    "test-only": "cross-env NODE_ENV=test ./node_modules/.bin/mocha test/*.test.js test/**/*.test.js --exit",
    "test": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text mocha test/*.test.js test/**/*.test.js --exit",
    "posttest": "nyc check-coverage --statements 90 --branches 75 --functions 90 --lines 90"
  },
  "dependencies": {
    "chalk": "^3.0.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0"
  },
  "nyc": {
    "include": "src",
    "exclude": []
  },
  "description": "A small terminal prompt and in-memory editor used by Secrez.",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/secrez/secrez.git"
  },
  "author": {
    "name": "Francesco Sullo",
    "email": "francesco@sullo.co"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
